---
import NavLink from "@/components/navbar/NavLink.astro";
import { Menu, X } from "@lucide/astro";
import { t } from "@/i18n";

const links = [
  { href: "#inicio", label: t.header.nav.inicio, labelKey: "header.nav.inicio" },
  { href: "#detalles", label: t.header.nav.detalles, labelKey: "header.nav.detalles" },
  { href: "#rsvp", label: t.header.nav.rsvp, labelKey: "header.nav.rsvp" },
];
---

<header class="relative z-50 bg-main-500 py-6 border-b border-third-200">
  <div class="container mx-auto flex flex-row items-center justify-between px-4 lg:px-0">
    <h1 class="text-white font-title text-5xl" data-i18n="header.title">{t.header.title}</h1>
    <nav class="flex flex-row items-center gap-8">
      {links.map((link) => <NavLink {...link} className="hidden lg:block" />)}
      <div id="lang-switcher" class="flex items-center gap-1 text-xs font-semibold text-white">
        <button type="button" data-lang-option="es" aria-label="Español" class="opacity-100">
          ES
        </button>
        <span class="opacity-50">/</span>
        <button type="button" data-lang-option="en" aria-label="English" class="opacity-50">
          EN
        </button>
      </div>
      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden text-white"
        aria-label={t.header.openMenu}
        data-i18n="header.openMenu"
        data-i18n-attr="aria-label"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu id="menu-icon-open" />
        <X id="menu-icon-close" class="hidden" />
      </button>
    </nav>
  </div>

  <nav
    id="mobile-menu"
    class="lg:hidden absolute top-full left-0 grid grid-rows-[0fr] w-full bg-main-500 transition-[grid-template-rows] duration-300 ease-in-out"
  >
    <div class="overflow-hidden">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link block text-white text-lg text-center py-4 border-t border-third-200/20"
            data-i18n={link.labelKey}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const iconOpen = document.querySelector<HTMLElement>("#menu-icon-open");
  const iconClose = document.querySelector<HTMLElement>("#menu-icon-close");
  const links = document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link");

  const closeMenu = () => {
    menu?.classList.remove("grid-rows-[1fr]");
    menu?.classList.add("grid-rows-[0fr]");
    toggle?.setAttribute("aria-expanded", "false");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
  };

  const openMenu = () => {
    menu?.classList.remove("grid-rows-[0fr]");
    menu?.classList.add("grid-rows-[1fr]");
    toggle?.setAttribute("aria-expanded", "true");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  links.forEach((link) => link.addEventListener("click", closeMenu));
</script>

<script>
  import { getLang, setLang, type Lang } from "@/i18n/runtime";

  const langButtons = document.querySelectorAll<HTMLButtonElement>("[data-lang-option]");

  const updateActive = (lang: Lang) => {
    langButtons.forEach((button) => {
      const isActive = button.dataset.langOption === lang;
      button.classList.toggle("opacity-100", isActive);
      button.classList.toggle("opacity-50", !isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });
  };

  updateActive(getLang());
  document.addEventListener("langchange", ((event: CustomEvent<Lang>) => {
    updateActive(event.detail);
  }) as EventListener);

  langButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setLang(button.dataset.langOption as Lang);
    });
  });
</script>
