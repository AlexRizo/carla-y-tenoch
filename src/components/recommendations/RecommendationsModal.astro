---
import { Building2, Church, Landmark, MapPin, Mountain, Sailboat, Soup, TreePalm, X } from "@lucide/astro";
import RecommendationRow from "@/components/recommendations/RecommendationRow.astro";
import Divider from "../common/Divider.astro";
import { t } from "@/i18n";

const RECOMMENDATIONS = [
  {
    icon: Church,
    title: t.recommendationsModal.comala.title,
    titleKey: "recommendationsModal.comala.title",
    description: t.recommendationsModal.comala.description,
    descriptionKey: "recommendationsModal.comala.description",
  },
  {
    icon: Landmark,
    title: t.recommendationsModal.nogueras.title,
    titleKey: "recommendationsModal.nogueras.title",
    description: t.recommendationsModal.nogueras.description,
    descriptionKey: "recommendationsModal.nogueras.description",
  },
  {
    icon: Mountain,
    title: t.recommendationsModal.montana.title,
    titleKey: "recommendationsModal.montana.title",
    description: t.recommendationsModal.montana.description,
    descriptionKey: "recommendationsModal.montana.description",
  },
  {
    icon: Building2,
    title: t.recommendationsModal.centro.title,
    titleKey: "recommendationsModal.centro.title",
    description: t.recommendationsModal.centro.description,
    descriptionKey: "recommendationsModal.centro.description",
  },
  {
    icon: TreePalm,
    title: t.recommendationsModal.manzanillo.title,
    titleKey: "recommendationsModal.manzanillo.title",
    description: t.recommendationsModal.manzanillo.description,
    descriptionKey: "recommendationsModal.manzanillo.description",
  },
  {
    icon: Sailboat,
    title: t.recommendationsModal.cuyutlan.title,
    titleKey: "recommendationsModal.cuyutlan.title",
    description: t.recommendationsModal.cuyutlan.description,
    descriptionKey: "recommendationsModal.cuyutlan.description",
  },
  {
    icon: Soup,
    title: t.recommendationsModal.gastronomia.title,
    titleKey: "recommendationsModal.gastronomia.title",
    description: t.recommendationsModal.gastronomia.description,
    descriptionKey: "recommendationsModal.gastronomia.description",
    dashed: true,
  },
];
---

<dialog
  id="recomendaciones-modal"
  class="m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-md rounded-2xl bg-third-200 p-0 backdrop:bg-black/50"
>
  <div class="flex max-h-[85vh] flex-col">
    <header class="relative flex flex-col items-center gap-2 border-b border-main-600/25 px-5 pt-6 pb-4">
      <button
        id="recomendaciones-modal-close"
        type="button"
        aria-label={t.common.close}
        data-i18n="common.close"
        data-i18n-attr="aria-label"
        class="absolute right-3 top-3 rounded-full p-1.5 text-secondary-600 hover:bg-secondary-200/50"
      >
        <X class="size-5" />
      </button>
      <MapPin class="size-8 text-secondary-600" stroke-width={1.5} />
      <h2 class="text-lg font-bold uppercase tracking-wide text-secondary-600" data-i18n="recommendationsModal.title">{t.recommendationsModal.title}</h2>
      <div class="flex flex-col items-center gap-1 pt-1">
        <p class="text-xs text-secondary-600" data-i18n="recommendationsModal.subtitle">{t.recommendationsModal.subtitle}</p>
      </div>
    </header>

    <div class="flex-1 space-y-3 overflow-y-auto px-5 py-5">
      {
        RECOMMENDATIONS.map((item) => (
          <RecommendationRow
            icon={item.icon}
            title={item.title}
            titleKey={item.titleKey}
            description={item.description}
            descriptionKey={item.descriptionKey}
            dashed={item.dashed}
          />
        ))
      }
    </div>

    <footer class="border-t border-main-600/25 px-5 py-3">
      <p class="text-center text-[0.7rem] italic text-secondary-600" data-i18n="recommendationsModal.footerNote">
        {t.recommendationsModal.footerNote}
      </p>
    </footer>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#recomendaciones-modal");
  const closeButton = document.querySelector<HTMLButtonElement>("#recomendaciones-modal-close");
  const triggers = document.querySelectorAll<HTMLAnchorElement>('a[href="#recomendaciones-modal"]');

  if (dialog && closeButton) {
    function lockScroll() {
      document.body.style.overflow = "hidden";
    }

    function unlockScroll() {
      document.body.style.overflow = "";
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        dialog.showModal();
        lockScroll();
      });
    });

    closeButton.addEventListener("click", () => {
      dialog.close();
      unlockScroll();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
        unlockScroll();
      }
    });

    dialog.addEventListener("cancel", unlockScroll);
  }
</script>
