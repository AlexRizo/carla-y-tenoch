---
import { Building2, Mountain, Plane, Trees } from "@lucide/astro";
import { X } from "@lucide/astro";
import AirportRow from "@/components/airport/AirportRow.astro";
import Divider from "@/components/common/Divider.astro";
import { t } from "@/i18n";

const AIRPORT_GROUPS = [
  {
    airport: t.airportModal.groups.guadalajara,
    airportKey: "airportModal.groups.guadalajara",
    destinations: [
      { icon: Building2, destination: t.airportModal.destinations.colima, destinationKey: "airportModal.destinations.colima", time: "2 h 30 min" },
      { icon: Trees, destination: t.airportModal.destinations.villaDeAlvarez, destinationKey: "airportModal.destinations.villaDeAlvarez", time: "2 h 40 min" },
      { icon: Mountain, destination: t.airportModal.destinations.comala, destinationKey: "airportModal.destinations.comala", time: "2 h 50 min" },
    ],
  },
  {
    airport: t.airportModal.groups.cuauhtemoc,
    airportKey: "airportModal.groups.cuauhtemoc",
    destinations: [
      { icon: Building2, destination: t.airportModal.destinations.colima, destinationKey: "airportModal.destinations.colima", time: "25 min" },
      { icon: Trees, destination: t.airportModal.destinations.villaDeAlvarez, destinationKey: "airportModal.destinations.villaDeAlvarez", time: "20 min" },
      { icon: Mountain, destination: t.airportModal.destinations.comala, destinationKey: "airportModal.destinations.comala", time: "35 min" },
    ],
  },
];
---

<dialog
  id="aeropuerto-modal"
  class="m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-md rounded-2xl bg-third-200 p-0 backdrop:bg-black/50"
>
  <div class="flex max-h-[85vh] flex-col">
    <header class="relative flex flex-col items-center gap-2 border-b border-main-600/25 px-5 pt-6 pb-4">
      <button
        id="aeropuerto-modal-close"
        type="button"
        aria-label={t.common.close}
        data-i18n="common.close"
        data-i18n-attr="aria-label"
        class="absolute right-3 top-3 rounded-full p-1.5 text-secondary-600 hover:bg-secondary-200/50"
      >
        <X class="size-5" />
      </button>
      <Plane class="size-8 text-secondary-600" stroke-width={1.5} />
      <h2 class="text-lg font-bold uppercase tracking-wide text-secondary-600" data-i18n="airportModal.title">{t.airportModal.title}</h2>
      <div class="flex flex-col items-center pt-1">
        <p class="text-xs text-secondary-600 text-center" data-i18n="airportModal.subtitle">
          {t.airportModal.subtitle}
        </p>
      </div>
    </header>

    <div class="flex-1 space-y-6 overflow-y-auto px-5 py-5">
      {
        AIRPORT_GROUPS.map((group) => (
          <div class="space-y-3">
            <div class="w-fit rounded-full bg-secondary-600 px-3 py-1.5 text-white">
              <span class="text-xs font-semibold uppercase" data-i18n={group.airportKey}>{group.airport}</span>
            </div>
            <div class="space-y-3">
              {group.destinations.map((destination) => (
                <AirportRow
                  icon={destination.icon}
                  destination={destination.destination}
                  destinationKey={destination.destinationKey}
                  time={destination.time}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <footer class="border-t border-main-600/25 px-5 py-3">
      <p class="text-center text-[0.7rem] text-secondary-600" data-i18n="airportModal.footerNote">
        {t.airportModal.footerNote}
      </p>
    </footer>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#aeropuerto-modal");
  const closeButton = document.querySelector<HTMLButtonElement>("#aeropuerto-modal-close");
  const triggers = document.querySelectorAll<HTMLAnchorElement>('a[href="#aeropuerto-modal"]');

  if (dialog && closeButton) {
    function lockScroll() {
      document.body.style.overflow = "hidden";
    }

    function unlockScroll() {
      document.body.style.overflow = "";
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        dialog.showModal();
        lockScroll();
      });
    });

    closeButton.addEventListener("click", () => {
      dialog.close();
      unlockScroll();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
        unlockScroll();
      }
    });

    dialog.addEventListener("cancel", unlockScroll);
  }
</script>
