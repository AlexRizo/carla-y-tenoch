---
import { Building2, Mountain, Trees } from "@lucide/astro";
import { X } from "@lucide/astro";
import AirportRow from "@/components/airport/AirportRow.astro";

const AIRPORT_GROUPS = [
  {
    airport: "Aeropuerto Internacional de Guadalajara",
    destinations: [
      { icon: Building2, destination: "Colima", time: "2 h 30 min" },
      { icon: Trees, destination: "Villa de Álvarez", time: "2 h 40 min" },
      { icon: Mountain, destination: "Comala", time: "2 h 50 min" },
    ],
  },
  {
    airport: "Aeropuerto de Cuauhtémoc, Colima",
    destinations: [
      { icon: Building2, destination: "Colima", time: "25 min" },
      { icon: Trees, destination: "Villa de Álvarez", time: "20 min" },
      { icon: Mountain, destination: "Comala", time: "35 min" },
    ],
  },
];
---

<dialog
  id="aeropuerto-modal"
  class="m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-md rounded-2xl bg-third-200 p-0 backdrop:bg-black/50"
>
  <div class="flex max-h-[85vh] flex-col">
    <header class="flex items-center justify-between border-b border-main-600/25 px-5 py-4">
      <div>
        <h2 class="text-sm font-semibold uppercase">Aeropuerto</h2>
        <p class="text-xs text-secondary-600">Tiempos estimados para llegar a los municipios</p>
      </div>
      <button
        id="aeropuerto-modal-close"
        type="button"
        aria-label="Cerrar"
        class="rounded-full p-1.5 text-secondary-600 hover:bg-secondary-200/50"
      >
        <X class="size-5" />
      </button>
    </header>

    <div class="flex-1 space-y-6 overflow-y-auto px-5 py-5">
      {
        AIRPORT_GROUPS.map((group) => (
          <div class="space-y-3">
            <div class="w-fit rounded-full bg-secondary-600 px-3 py-1.5 text-white">
              <span class="text-xs font-semibold uppercase">{group.airport}</span>
            </div>
            <div class="space-y-3">
              {group.destinations.map((destination) => (
                <AirportRow
                  icon={destination.icon}
                  destination={destination.destination}
                  time={destination.time}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <footer class="border-t border-main-600/25 px-5 py-3">
      <p class="text-center text-[0.7rem] text-secondary-600">
        Tiempos estimados en auto. Pueden variar según el tráfico.
      </p>
    </footer>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#aeropuerto-modal");
  const closeButton = document.querySelector<HTMLButtonElement>("#aeropuerto-modal-close");
  const triggers = document.querySelectorAll<HTMLAnchorElement>('a[href="#aeropuerto-modal"]');

  if (dialog && closeButton) {
    function lockScroll() {
      document.body.style.overflow = "hidden";
    }

    function unlockScroll() {
      document.body.style.overflow = "";
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        dialog.showModal();
        lockScroll();
      });
    });

    closeButton.addEventListener("click", () => {
      dialog.close();
      unlockScroll();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
        unlockScroll();
      }
    });

    dialog.addEventListener("cancel", unlockScroll);
  }
</script>
