---
import type { AstroComponent } from "@lucide/astro";
import { Icon } from 'astro-icon/components';

interface Props {
  icon: AstroComponent | string;
  title: string;
  titleKey?: string;
  description: string;
  descriptionKey?: string;
  href: string;
  label: string;
  labelKey?: string;
  copyText?: string;
}

const { icon, title, titleKey, description, descriptionKey, href, label, labelKey, copyText } = Astro.props;

const LucideIcon = icon as AstroComponent;
const iconPath = icon as string;
---

<article class="flex flex-col items-center w-96 gap-3 py-6">
  <div class="bg-primary rounded-full">
    {
      typeof icon === "string" ? (
        <Icon name={iconPath} class="size-10 text-secondary-600" />
      ) : (
        <LucideIcon class="size-10 text-secondary-600" stroke-width={1.25} />
      )
    }
  </div>
  <h2 class="text-sm font-semibold uppercase" data-i18n={titleKey}>{title}</h2>
  <p class="text-xs text-center leading-relaxed max-w-50.5" data-i18n={descriptionKey}>{description}</p>
  {
    copyText ? (
      <button
        type="button"
        data-copy-text={copyText}
        data-i18n={labelKey}
        class="text-xs uppercase text-white px-4 py-0.5 rounded bg-secondary-600 hover:opacity-90 transition-opacity mt-auto cursor-pointer"
      >
        {label}
      </button>
    ) : (
      <a
        href={href}
        target="_blank"
        class="text-xs uppercase text-white px-4 py-0.5 rounded bg-secondary-600 hover:opacity-90 transition-opacity mt-auto"
        data-i18n={labelKey}
      >
        {label}
      </a>
    )
  }
</article>

<script>
  import { dict } from "@/i18n";
  import { getLang } from "@/i18n/runtime";

  document.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((button) => {
    button.addEventListener("click", async () => {
      const text = button.dataset.copyText ?? "";
      const originalLabel = button.textContent ?? "";

      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }

      button.textContent = dict[getLang()].extras.hashtag.copied;
      setTimeout(() => {
        button.textContent = originalLabel;
      }, 1500);
    });
  });
</script>
