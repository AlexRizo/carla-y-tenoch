---
import type { AstroComponent } from "@lucide/astro";

interface Props {
  icon: AstroComponent;
  title: string;
  titleKey?: string;
  value: string | string[];
  valueKey?: string;
  button?: boolean;
  buttonText?: string;
  buttonTextKey?: string;
  href?: string;
}

const { title, titleKey, value, valueKey, icon: Icon, button, buttonText, buttonTextKey, href } = Astro.props;
---

<article class="flex flex-col gap-3 items-center text-xs py-5 lg:py-0">
  <Icon size={50} stroke-width={1.25} class="text-secondary-600" />
  <h1 class="uppercase font-medium tracking-wider" data-i18n={titleKey}>{title}</h1>
  <div class="text-center max-w-46 leading-relaxed">
    {Array.isArray(value) ? (
      value.map((item, index) => <p data-i18n={valueKey ? `${valueKey}.${index}` : undefined}>{item}</p>)
    ) : (
      <p data-i18n={valueKey}>{value}</p>
    )}
  </div>
  {button && <a href={href} target="_blank" rel="noopener" class="bg-secondary-600 hover:opacity-95 text-third-100 px-2.5 py-1.5 rounded mt-auto uppercase" data-i18n={buttonTextKey}>{buttonText}</a>}
</article>
