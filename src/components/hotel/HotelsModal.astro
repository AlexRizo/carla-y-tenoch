---
import { Building2, Mountain, Trees, X } from "@lucide/astro";
import HotelCard from "@/components/hotel/HotelCard.astro";
import { t } from "@/i18n";

const HOTEL_GROUPS = [
  {
    icon: Building2,
    zone: t.hotelsModal.zones.centroColima,
    zoneKey: "hotelsModal.zones.centroColima",
    hotels: [
      {
        image: "/images/hotels/hacienda-del-gobernador.webp",
        name: "Hotel Boutique Hacienda del Gobernador Colima",
        church_time: 5,
        reception_time: 25,
        href: "https://wubook.net/wbkd/wbk/?lcode=1753396768",
      },
      {
        image: "/images/hotels/concierge-plaza-colima.webp",
        name: "Hotel Concierge Plaza Colima",
        church_time: 5,
        reception_time: 25,
        href: "https://conciergeplazacolima.com/es?occupancy=2&currency=MXN",
      },
    ],
  },
  {
    icon: Trees,
    zone: t.hotelsModal.zones.villaDeAlvarez,
    zoneKey: "hotelsModal.zones.villaDeAlvarez",
    hotels: [
      {
        image: "/images/hotels/concierge-plaza-la-villa.webp",
        name: "Concierge Plaza La Villa",
        church_time: 10,
        reception_time: 20,
        href: "https://conciergeplazalavilla.com/es?occupancy=2&currency=MXN",
      },
    ],
  },
  {
    icon: Mountain,
    zone: t.hotelsModal.zones.comala,
    zoneKey: "hotelsModal.zones.comala",
    hotels: [
      {
        image: "/images/hotels/comalitos-hotel.webp",
        name: "Comalitas Hotel",
        church_time: 20,
        reception_time: 12,
        href: "https://comalitas.com/",
      },
      {
        image: "/images/hotels/casa-alvarada.webp",
        name: "Hotel Casa Alvarada",
        church_time: 20,
        reception_time: 12,
        href: "https://www.casaalvarada.com/",
      },
    ],
  },
];
---

<dialog
  id="hospedaje-modal"
  class="m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-md rounded-2xl bg-third-200 p-0 backdrop:bg-black/50"
>
  <div class="flex max-h-[85vh] flex-col">
    <header class="relative flex flex-col items-center gap-2 border-b border-main-600/25 px-5 pt-6 pb-4">
      <button
        id="hospedaje-modal-close"
        type="button"
        aria-label={t.common.close}
        data-i18n="common.close"
        data-i18n-attr="aria-label"
        class="absolute right-3 top-3 rounded-full p-1.5 text-secondary-600 hover:bg-secondary-200/50"
      >
        <X class="size-5" />
      </button>
      <Building2 class="size-8 text-secondary-600" stroke-width={1.5} />
      <h2 class="text-lg font-bold uppercase tracking-wide text-secondary-600" data-i18n="hotelsModal.title">{t.hotelsModal.title}</h2>
      <p class="text-xs text-secondary-600" data-i18n="hotelsModal.subtitle">{t.hotelsModal.subtitle}</p>
    </header>

    <div class="flex-1 space-y-6 overflow-y-auto px-5 py-5">
      {
        HOTEL_GROUPS.map((group) => (
          <div class="space-y-3">
            <div class="flex items-center gap-2 rounded-full bg-secondary-600 px-3 py-1.5 text-white w-fit">
              <group.icon class="size-4" stroke-width={1.5} />
              <span class="text-xs font-semibold uppercase" data-i18n={group.zoneKey}>{group.zone}</span>
            </div>
            <div class="space-y-3">
              {group.hotels.map((hotel) => (
                <HotelCard
                  image={hotel.image}
                  name={hotel.name}
                  church_time={hotel.church_time}
                  reception_time={hotel.reception_time}
                  href={hotel.href}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <footer class="border-t border-main-600/25 px-5 py-3">
      <p class="text-center text-[0.7rem] text-secondary-600" data-i18n="hotelsModal.footerNote">
        {t.hotelsModal.footerNote}
      </p>
    </footer>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#hospedaje-modal");
  const closeButton = document.querySelector<HTMLButtonElement>("#hospedaje-modal-close");
  const triggers = document.querySelectorAll<HTMLAnchorElement>('a[href="#hospedaje-modal"]');

  if (dialog && closeButton) {
    function lockScroll() {
      document.body.style.overflow = "hidden";
    }

    function unlockScroll() {
      document.body.style.overflow = "";
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        dialog.showModal();
        lockScroll();
      });
    });

    closeButton.addEventListener("click", () => {
      dialog.close();
      unlockScroll();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
        unlockScroll();
      }
    });

    dialog.addEventListener("cancel", unlockScroll);
  }
</script>
