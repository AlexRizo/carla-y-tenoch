---
import { Church, Wine } from "@lucide/astro";
import { t } from "@/i18n";

interface Props {
  image: string;
  name: string;
  church_time: number;
  reception_time: number;
  href: string;
}

const { image, name, church_time, reception_time, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="flex flex-col gap-3 rounded-xl bg-third-100 p-3 transition hover:opacity-90 sm:flex-row sm:items-center sm:gap-4"
>
  <div class="flex items-center gap-3 sm:contents">
    <img
      src={image}
      alt={name}
      class="h-16 w-16 shrink-0 rounded-lg object-cover sm:h-20 sm:w-20"
    />
    <h3 class="flex-1 text-sm font-semibold leading-tight">{name}</h3>
  </div>
  <div class="flex gap-4 shrink-0">
    <div class="flex flex-1 flex-row items-center justify-center gap-1 text-secondary-600 sm:flex-none">
      <Church class="size-5" stroke-width={1.5} />
      <p class="text-center text-[0.65rem] leading-tight">
        <span class="block" data-i18n="hotelsModal.toChurch">{t.hotelsModal.toChurch}</span>
        <span class="block font-semibold text-sm">{church_time} min</span>
        <span class="block" data-i18n="hotelsModal.byCar">{t.hotelsModal.byCar}</span>
      </p>
    </div>
    <div class="flex flex-1 flex-row items-center justify-center gap-1 text-secondary-600 sm:flex-none">
      <Wine class="size-5" stroke-width={1.5} />
      <p class="text-center text-[0.65rem] leading-tight">
        <span class="block" data-i18n="hotelsModal.toVenue">{t.hotelsModal.toVenue}</span>
        <span class="block font-semibold text-sm">{reception_time} min</span>
        <span class="block" data-i18n="hotelsModal.byCar">{t.hotelsModal.byCar}</span>
      </p>
    </div>
  </div>
</a>
