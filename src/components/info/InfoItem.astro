---
import type { AstroComponent } from "@lucide/astro";

interface Props {
  icon: AstroComponent;
  title: string;
  description: string;
  href: string;
  label: string;
}

const { icon: Icon, title, description, href, label } = Astro.props;
---

<article class="flex flex-col items-center gap-3 w-full py-6">
  <div class="bg-primary rounded-full">
    <Icon class="size-10 text-secondary-600" stroke-width={1.25} />
  </div>
  <h2 class="text-sm font-semibold uppercase">{title}</h2>
  <p class="text-xs text-center leading-relaxed max-w-50.5">{description}</p>
  <a
    href={href}
    target="_blank"
    class="text-xs uppercase text-white px-6 py-1.5 rounded bg-secondary-600 hover:opacity-90 transition-opacity mt-auto"
    >{label}</a
  >
</article>
