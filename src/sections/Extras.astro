---
import { Hash } from "@lucide/astro";
import ExtraItem from "@/components/extras/ExtraItem.astro";

const EXTRAS_DATA = [
  {
    icon: "spotify",
    title: "Playlist",
    description: "Nuestra playlist especial para ti",
    href: "",
    label: "Ver opciones",
  },
  {
    icon: Hash,
    title: "Hashtag",
    description: "Comparte tus fotos con nuestro hashtag #CarlaYTenoch2026",
    href: "",
    label: "Copiar",
  },
  {
    icon: "googledrive",
    title: "Comparte tus fotos",
    description: "Sube tus fotos y sé parte del recuerdo",
    href: "",
    label: "Ir al drive",
  },
];
---

<section class="bg-third-100 py-4 lg:py-0">
  <div class="container mx-auto lg:pb-6 px-4 lg:px-0">
    <h1
      class="text-xl text-main-500 tracking-wider text-center pt-6 pb-2 uppercase"
    >
      Extras
    </h1>
    <div
      class="flex flex-col lg:flex-row justify-center divide-y lg:divide-y-0 lg:divide-x divide-main-600/25 max-w-96 lg:max-w-none mx-auto"
    >
      {
        EXTRAS_DATA.map((extra) => (
          <ExtraItem
            icon={extra.icon}
            title={extra.title}
            description={extra.description}
            href={extra.href}
            label={extra.label}
          />
        ))
      }
    </div>
  </div>
</section>
