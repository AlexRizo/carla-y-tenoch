---
import { Hash } from "@lucide/astro";
import ExtraItem from "@/components/extras/ExtraItem.astro";
import { t } from "@/i18n";

const EXTRAS_DATA = [
  {
    icon: "spotify",
    title: t.extras.playlist.title,
    titleKey: "extras.playlist.title",
    description: t.extras.playlist.description,
    descriptionKey: "extras.playlist.description",
    href: "https://open.spotify.com/playlist/05kYVhNZLFwOUmUkSJpZZm?si=CN31Eq9jT-q36gi8H7eqsQ&utm_source=copy-link&pi=VdwehctDTPGNy&nd=1&dlsi=d9f9d67df5bf44cd",
    label: t.extras.playlist.label,
    labelKey: "extras.playlist.label",
  },
  {
    icon: Hash,
    title: t.extras.hashtag.title,
    titleKey: "extras.hashtag.title",
    description: t.extras.hashtag.description,
    descriptionKey: "extras.hashtag.description",
    href: "",
    label: t.extras.hashtag.label,
    labelKey: "extras.hashtag.label",
    copyText: "#CarlaYTenoch2026",
  },
  {
    icon: "googledrive",
    title: t.extras.drive.title,
    titleKey: "extras.drive.title",
    description: t.extras.drive.description,
    descriptionKey: "extras.drive.description",
    href: "https://drive.google.com/drive/folders/1oW7xnKna2OyEh7OMG5wfaVZ2gUvYgIfx",
    label: t.extras.drive.label,
    labelKey: "extras.drive.label",
  },
];
---

<section class="bg-third-100 py-4 lg:py-0">
  <div class="container mx-auto lg:pb-6 px-4 lg:px-0">
    <h1
      class="text-xl text-main-500 tracking-wider text-center pt-6 pb-2 uppercase"
      data-i18n="extras.heading"
    >
      {t.extras.heading}
    </h1>
    <div
      class="flex flex-col lg:flex-row justify-center divide-y lg:divide-y-0 lg:divide-x divide-main-600/25 max-w-96 lg:max-w-none mx-auto"
    >
      {
        EXTRAS_DATA.map((extra) => (
          <ExtraItem
            icon={extra.icon}
            title={extra.title}
            titleKey={extra.titleKey}
            description={extra.description}
            descriptionKey={extra.descriptionKey}
            href={extra.href}
            label={extra.label}
            labelKey={extra.labelKey}
            copyText={extra.copyText}
          />
        ))
      }
    </div>
  </div>
</section>
