---
import Divider from "@/components/common/Divider.astro";
import DetailCard from "@/components/DetailCard.astro";
import { Calendar, Church, Wine } from "@lucide/astro";
import { t } from "@/i18n";

const detailsData = [
  {
    icon: Calendar,
    title: t.details.fecha.title,
    titleKey: "details.fecha.title",
    value: t.details.fecha.value,
    valueKey: "details.fecha.value",
  },
  {
    icon: Church,
    title: t.details.ceremonia.title,
    titleKey: "details.ceremonia.title",
    value: t.details.ceremonia.value,
    valueKey: "details.ceremonia.value",
    button: true,
    buttonText: t.details.ceremonia.buttonText,
    buttonTextKey: "details.ceremonia.buttonText",
    href: "https://maps.app.goo.gl/Yv8kmRFQMVP9dwyV8",
  },
  {
    icon: Wine,
    title: t.details.recepcion.title,
    titleKey: "details.recepcion.title",
    value: t.details.recepcion.value,
    valueKey: "details.recepcion.value",
    button: true,
    buttonText: t.details.recepcion.buttonText,
    buttonTextKey: "details.recepcion.buttonText",
    href: "https://maps.app.goo.gl/vR3UKWxT7SJfxYuo7",
  },
];
---

<section id="detalles" class="bg-third-100 py-10 lg:p-10">
  <div class="max-w-96 lg:container mx-auto px-4 lg:px-0">
    <article class="mx-auto w-fit">
      <h1
        class="text-center text-main-600 uppercase text-lg font-subtitle font-bold tracking-wider"
        data-i18n="details.heading"
      >
        {t.details.heading}
      </h1>
      <Divider color="red" />
    </article>

    <div
      class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x divide-main-600/15"
    >
      {detailsData.map((detail) => <DetailCard {...detail} />)}
    </div>
  </div>
</section>
