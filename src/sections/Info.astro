---
import InfoItem from "@/components/info/InfoItem.astro";
import HotelsModal from "@/components/hotel/HotelsModal.astro";
import AirportModal from "@/components/airport/AirportModal.astro";
import RecommendationsModal from "@/components/recommendations/RecommendationsModal.astro";
import { Building2, CarFront, CloudSun, MapPin, Plane } from "@lucide/astro";
import { t } from "@/i18n";

const INFO_DATA = [
  {
    icon: Building2,
    title: t.info.hospedaje.title,
    titleKey: "info.hospedaje.title",
    description: t.info.hospedaje.description,
    descriptionKey: "info.hospedaje.description",
    href: "#hospedaje-modal",
    label: t.info.hospedaje.label,
    labelKey: "info.hospedaje.label",
  },
  {
    icon: Plane,
    title: t.info.aeropuerto.title,
    titleKey: "info.aeropuerto.title",
    description: t.info.aeropuerto.description,
    descriptionKey: "info.aeropuerto.description",
    href: "#aeropuerto-modal",
    label: t.info.aeropuerto.label,
    labelKey: "info.aeropuerto.label",
  },
  {
    icon: CloudSun,
    title: t.info.clima.title,
    titleKey: "info.clima.title",
    description: t.info.clima.description,
    descriptionKey: "info.clima.description",
    href: "https://www.meteored.mx/clima_Comala-America+Norte-Mexico-Colima--1-21207.html",
    label: t.info.clima.label,
    labelKey: "info.clima.label",
  },
  {
    icon: MapPin,
    title: t.info.recomendaciones.title,
    titleKey: "info.recomendaciones.title",
    description: t.info.recomendaciones.description,
    descriptionKey: "info.recomendaciones.description",
    href: "#recomendaciones-modal",
    label: t.info.recomendaciones.label,
    labelKey: "info.recomendaciones.label",
  },
];
---

<section class="bg-third-200">
  <img
    src="/images/gallery/09.webp"
    alt="Carla y Tenoch"
    class="w-full h-86 object-cover lg:object-[0_35%]"
  />
  <div class="flex flex-col lg:flex-row px-4 lg:px-0 divide-y lg:divide-y-0 lg:divide-x divide-main-600/25 max-w-96 lg:container mx-auto">
    {
      INFO_DATA.map((info) => (
        <InfoItem
          icon={info.icon}
          title={info.title}
          titleKey={info.titleKey}
          description={info.description}
          descriptionKey={info.descriptionKey}
          href={info.href}
          label={info.label}
          labelKey={info.labelKey}
        />
      ))
    }
  </div>
  <HotelsModal />
  <AirportModal />
  <RecommendationsModal />
</section>
