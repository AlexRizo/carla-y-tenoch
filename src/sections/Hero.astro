---
import Divider from "@/components/common/Divider.astro";
import { t } from "@/i18n";
---

<section
  id="inicio"
  class="h-svh bg-[url('/images/gallery/01.webp')] lg:1bg-[url('/images/01-HOME.webp')] bg-cover bg-center"
>
  <div
    class="max-w-96 lg:container mx-auto lg:pl-10 h-full flex flex-col lg:flex-row items-center"
  >
    <article class="text-white lg:w-min mt-24 lg:mt-0">
      <h1
        class="font-title text-7xl lg:text-9xl flex flex-col text-center leading-0"
      >
        <span data-i18n="hero.name1">{t.hero.name1}</span>
        <span class="font-elegant italic text-4xl lg:text-7xl mt-8 mb-12 lg:mt-14 lg:mb-22" data-i18n="hero.and">{t.hero.and}</span>
        <span data-i18n="hero.name2">{t.hero.name2}</span>
      </h1>
      <Divider className="mt-14 mb-4" />
      <p class="text-lg lg:text-xl text-center uppercase">
        <span data-i18n="hero.date">{t.hero.date}</span>
        <br />
        <span data-i18n="hero.location">{t.hero.location}</span>
      </p>
    </article>
  </div>
</section>
