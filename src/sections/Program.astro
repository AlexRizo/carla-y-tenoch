---
import ProgramDivider from "@/components/program/ProgramDivider.astro";
import ProgramItem from "@/components/program/ProgramItem.astro";
import { Blend, Church, Music, Utensils, Wine } from "@lucide/astro";

const programs = [
  {
    hour: "04:00 pm",
    place: "Misa",
    icon: Church,
  },
  {
    hour: "06:00 pm",
    place: "Recepción",
    icon: Wine,
  },
  {
    hour: "07:00 pm",
    place: "Protocolo",
    icon: "rings",
  },
  {
    hour: "07:30 pm",
    place: "Cena",
    icon: Utensils,
  },
  {
    hour: "08:30 pm",
    place: "Baile",
    icon: Music,
  },
];
---

<section class="py-10 px-4 lg:py-10">
  <div class="max-w-96 lg:container mx-auto border border-main-600/20 p-10">
    <h1 class="uppercase font-medium mb-4 w-max mx-auto">Programa</h1>
    <div
      class="flex flex-col lg:flex-row items-center justify-center gap-10"
    >
      {
        programs.map((program, idx) => (
          <>
            <ProgramItem {...program} />
            {idx < programs.length - 1 && <ProgramDivider />}
          </>
        ))
      }
    </div>
  </div>
</section>
