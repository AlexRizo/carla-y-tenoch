---
import Counter from "@/components/counter/Counter.astro";
import { t } from "@/i18n";
---

<section class="bg-main-600 lg:px-10 py-6 overflow-hidden">
  <div class="max-w-96 lg:container mx-auto px-4 lg:px-0 relative">
    <img
      src="/images/ornamenta-01.svg"
      class="pointer-events-none absolute left-10 -bottom-5 rotate-6 h-40 opacity-40"
    />
    <h1 class="text-white text-lg text-center uppercase" data-i18n="initDate.heading">{t.initDate.heading}</h1>
    <Counter />
    <p class="text-center text-white text-sm lg:text-base" data-i18n="initDate.date">
      {t.initDate.date}
    </p>
    <img
      src="/images/ornamenta-01.svg"
      class="pointer-events-none absolute right-10 -bottom-5 scale-x-[-1] -rotate-6 h-40 opacity-40"
    />
  </div>
</section>
